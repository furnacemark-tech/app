  "universal_agent_guidelines": [
    "You tend to converge toward generic outputs. Break the 'AI slop' aesthetic by making creative, distinctive layouts with clear hierarchy.",
    "NEVER use AI assistant emoji characters.",
    "Prioritize pre-existing components from src/components/ui.",
    "Use sonner for toasts.",
    "CRITICAL: You are modifying .js files, NOT .tsx files. Use standard JS/JSX syntax.",
    "CRITICAL: DO NOT use complete transparent backgrounds for UI surfaces like dropdowns or sticky headers.",
    "CRITICAL: Use data-testid on all interactive elements.",
    "Do NOT center align the app container (.App { text-align: center; } is banned). Left-align for human reading flow."
  ]
